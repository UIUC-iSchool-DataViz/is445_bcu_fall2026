       "interactive(children=(Dropdown(description='colormap', options=('Accent', 'Accent_r', 'Blues', 'Blues_r', 'BrB…"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "@ipywidgets.interact(colormap = plt.colormaps())\n",
    "def make_plot(colormap):\n",
    "    fig, ax = plt.subplots(figsize=(8,0.8))\n",
    "    col_map = plt.get_cmap(colormap)\n",
    "    mpl.colorbar.ColorbarBase(ax, cmap=col_map, orientation = 'horizontal')\n",
    "    ax.xaxis.set_visible(False)\n",
    "    plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Note that in this case we did *not* use the `with` statement."

       "              1841.0, 1843.0,\n",
       "              ...\n",
       "              2010.0, 2011.0, 2012.0, 2013.0, 2014.0, 2015.0, 2016.0, 2017.0,\n",
       "              2018.0, 2019.0],\n",
       "             dtype='float64', name='Year Acquired', length=171)"
      ]
     },
     "execution_count": 35,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "aggregated_data.index "
   ]
  },

       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "interactive(children=(Dropdown(description='colormap_name', options=('Accent', 'Accent_r', 'Blues', 'Blues_r',…"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "color_steps = np.linspace(0,1.0,256) # never changes, can put outside\n",
    "\n",
    "@ipywidgets.interact(colormap_name = plt.colormaps())\n",
    "def plot_colormap(colormap_name):\n",
    "    fig = plt.figure() # create a figure object, but don't specify axes\n",
    "    \n",
    "    col_map = plt.get_cmap(colormap_name) # for both plots\n",
    "    colors = col_map(color_steps)[:,:3] # need to re-derive both times\n",
    "\n",
    "    # order here is: left, bottom, width, height\n",
    "    ax = fig.add_axes([0.0, 0.15, 1.0, 0.8]) # first set of axis: will hold color-levels plot\n",
    "\n",
    "    # this axes object will hold our colorlines:\n",
    "    ax.plot(color_steps, colors[:,0], '-r')\n",
    "    ax.plot(color_steps, colors[:,1], '-g')\n",
    "    ax.plot(color_steps, colors[:,2], '-b')\n",
    "    ###ax.set_ylabel('Relative Strenghts of R,G,B Representation')\n",
    "\n",
    "    ax.set_xlim(0.0, 1.0) # first I'm just gonna set this a little wider so the tops don't get cut off\n",
    "    ax.set_ylim(0.0, 1.01)\n",
    "    ax.xaxis.set_ticklabels([])\n",
    "    ax.yaxis.set_ticklabels([])\n",
    "\n",
    "    ax.xaxis.set_visible(False)\n",
    "    ax.yaxis.set_visible(False) \n",
    "\n",
    "    # colorbar\n",
    "    ax_colorbar = fig.add_axes([0.0, 0.0, 1.0, 0.2]) # right below our color lines\n",
    "    mpl.colorbar.ColorbarBase(ax_colorbar, cmap=col_map, orientation = 'horizontal')\n",
    "    ax_colorbar.xaxis.set_visible(False)\n",
    "\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Tah Dah!! 🎉"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Take aways\n",
    "* We can translate between matplotlib colormaps and RGB representations to show how R,G,B combinations look to our eyes\n",
    "* There are a variety of colormaps that can be used to highlight different parts of you viz\n",
    "### Important considerations: do not lie with colormaps (if we have time)\n",
    "* just say no to bad colormaps: https://jakevdp.github.io/blog/2014/10/16/how-bad-is-your-colormap/"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Palettes - picking colors to define your colormap (might skip in class)\n",
    "\n",
    "We've been using RGB sequences to smear together into colormaps. Now we will focus on methods to instead pick specific colors and mesh them into colormaps using the `palettable` package:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 79,
   "metadata": {},
   "outputs": [],
   "source": [
    "# this will need to be pip-installed or conda-installed\n",
    "import palettable"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Lets just pull a random palette and see what it looks like in both its original colors and as a continious colormap:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 80,
   "metadata": {},
   "outputs": [
    {
     "data": {

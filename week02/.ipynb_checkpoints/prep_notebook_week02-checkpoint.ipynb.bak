    "for grouped in buildings.groupby(\"Bldg Status\"):\n",
    "    print(grouped)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 106,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Abandon 226\n",
      "In Progress 113\n",
      "In Use 8523\n"
     ]
    }
   ],
   "source": [
    "for status, df in buildings.groupby(\"Bldg Status\"):\n",
    "    print(status, df.shape[0])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
